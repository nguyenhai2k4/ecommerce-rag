# ==============================================================================
# Google Gemini API Configuration
# Get your free/paid API key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Selection (e.g., gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
LLM_MODEL=models/gemini-2.5-flash

# Embedding Model Selection (e.g., text-embedding-004, gemini-embedding-2-preview)
EMBEDDING_MODEL=models/text-embedding-004

# Agent Execution Mode: 'function_calling' or 'react'
AGENT_MODE=function_calling

# Temperature (0.0 to 1.0) - Lower values ensure deterministic SQL & citations
TEMPERATURE=0.1

# Paths Configuration
SQLITE_DB_PATH=data/structured/ecommerce_retail.db
DOCS_DIR=data/unstructured
STORAGE_DIR=storage
