# ==============================================================================
# Model Provider Configuration
# Supported providers: 'google', 'deepseek', 'ollama'
# ==============================================================================
LLM_PROVIDER=google

# Google Gemini API Configuration (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2-preview

# DeepSeek API Configuration (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama Local Configuration (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
ENABLE_OLLAMA_FALLBACK=true

# Agent Execution Mode: 'function_calling' or 'react'
AGENT_MODE=function_calling

# Temperature (0.0 to 1.0) - Lower values ensure deterministic SQL & citations
TEMPERATURE=0.1

# Paths Configuration
SQLITE_DB_PATH=data/structured/ecommerce_retail.db
DOCS_DIR=data/unstructured
STORAGE_DIR=storage
