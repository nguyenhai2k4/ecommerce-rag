# ==============================================================================
# Google Gemini API Configuration
# Get your free/paid API key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Selection (Gemini 3.8 Flash)
LLM_MODEL=gemini-3.8-flash

# Embedding Model Selection (Gemini Embedding 2 Preview)
EMBEDDING_MODEL=gemini-embedding-2-preview

# Agent Execution Mode: 'function_calling' or 'react'
AGENT_MODE=function_calling

# Temperature (0.0 to 1.0) - Lower values ensure deterministic SQL & citations
TEMPERATURE=0.1

# Paths Configuration
SQLITE_DB_PATH=data/structured/ecommerce_retail.db
DOCS_DIR=data/unstructured
STORAGE_DIR=storage
